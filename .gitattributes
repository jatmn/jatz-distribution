*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.blend binary
*.exr binary
# Generated, self-contained preview pages: mostly embedded base64 images, over CI's 256 KiB text limit.
assets/*/previews/recolor.html binary
*.lua text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf

# Third-party files kept byte-for-byte as published upstream (assets/roads/README.md):
# never reformat them, so whitespace checks skip them.
assets/roads/yuoki-railways/** -whitespace
